# Copia este archivo a .env y completa los valores. .env NUNCA se sube a GitHub.
# Genera secretos con:  openssl rand -base64 48

# --- Base de datos (docker compose) ---
POSTGRES_DB=textrack
POSTGRES_USER=textrack
POSTGRES_PASSWORD=

# --- API ---
# JWT HS256 y firma HMAC de tickets: mínimo 32 caracteres aleatorios cada uno (la API no arranca si faltan).
JWT_SECRET=
TICKET_HMAC_SECRET=
# Orígenes permitidos (CORS y WebSocket), separados por coma. Sin comodines.
CORS_ALLOWED_ORIGINS=http://localhost:8088

# --- Datos de demostración (perfil demo) ---
# Contraseña de los usuarios internos de la demo (admin, planificación, supervisión, calidad, tablet): ≥ 12 caracteres.
SEED_ADMIN_PASSWORD=
# Contraseña del usuario público de solo lectura visor@textrack.demo: ≥ 8 caracteres.
DEMO_VIEWER_PASSWORD=

# --- Solo si ejecutas la API sin Docker ---
DB_URL=jdbc:postgresql://localhost:5432/textrack
DB_USER=textrack
DB_PASSWORD=
PORT=8081
SPRING_PROFILES_ACTIVE=demo
